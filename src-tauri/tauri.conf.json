{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halisland",
  "version": "0.1.0",
  "identifier": "com.halil.halisland",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Halisland",
        "width": 320,
        "height": 44,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Halil İlgez",
    "shortDescription": "Windows ve macOS için masaüstü Dynamic Island",
    "longDescription": "Ekranın üst ortasında duran cam görünümlü ada: saat, odak sayacı, çalan müzik ve Claude Code durumu.",
    "category": "Productivity",
    "copyright": "© 2026 Halil İlgez",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
