<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Halisland yerel asistanı. Halisland (src-tauri/src/assistant.rs) bu süreci
    açılışta başlatır; 127.0.0.1:47822 üzerinden arayüze hizmet verir ve
    Ollama ile konuşur.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>halisland-assistant</AssemblyName>
    <RootNamespace>Halisland.Assistant</RootNamespace>
    <Version>0.3.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- JSON kaynak üretici + minimal API: kırpmaya (trim) ve AOT'a uygun kod. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <!-- Sürüm derlemesi (release.yml): tek dosya, .NET kurulu olmadan çalışır. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- SQLite'ın yerel DLL'i (e_sqlite3) exe'nin içine girsin; kurulumda yalnızca exe var. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- IIS'e yönelik web.config ve modül DLL'i gerekmiyor; kurulumda yalnızca exe var. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

</Project>
